{
  "manifest_version": 3,
  "name": "Auto Bookmark Rules",
  "version": "1.0.0",
  "description": "Automatically bookmarks pages that match your rules into the folders you choose. Everything stays on your device.",
  "minimum_chrome_version": "102",
  "permissions": ["bookmarks", "tabs", "storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto Bookmark Rules",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
